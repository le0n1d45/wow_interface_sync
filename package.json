{
  "name": "wow-interface-sync",
  "version": "0.1.0",
  "description": "Sync WoW Forever addon settings via a private GitHub repo, and publish a WowUp export string.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "author": "Le0n1d45",
  "homepage": "https://github.com/le0n1d45/wow_interface_sync",
  "dependencies": {
    "isomorphic-git": "^1.44.12"
  },
  "license": "MIT"
}
